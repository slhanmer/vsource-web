flowchart TB
    CLIN["Authenticated User<br/>(browser, desktop only)"]

    subgraph FE["Front-end Container — Next.js 16 / React 19 (Software Item SI-FE)"]
        direction TB
        ROUTES["App Router<br/>(public) &amp; (secure) route groups"]
        GUARDS["Security Guards<br/>LoggedIn · AccessLevel · FeatureFlag · Wip · DesktopOnly"]
        FEAT["Feature Modules<br/>login/2FA · scans+viewer · forms · admin · tenant"]
        SVC["Services Layer<br/>useFetchApi (fetch wrapper,<br/>credentials: include)"]
        STATE["State — Zustand stores<br/>user · tenant · device · scan · form"]
        PROV["Providers<br/>Tenant (subdomain theming) · Ticket"]
        UIKIT["ui-kit + three.js viewer<br/>IndexedDB model cache (500MB LRU)"]
    end

    subgraph BE["Back-end Container — TypeScript / Express (Software Item SI-BE)"]
        direction TB
        API["REST API<br/>versioned service endpoints"]
        WS["Real-time Scan Channel<br/>WebSocket topics users/{client}/scans/list<br/><i>(PLANNED — APT-439)</i>"]
        AUTH["Auth &amp; Session<br/>HTTP-only cookies · 2FA<br/><i>2FA PLANNED</i>"]
        TEN["Tenancy &amp; Access Control<br/>device→tenant→user ownership"]
        FILESVC["Rust File Service<br/>signed-URL issuer · AWS SDK"]
    end

    DBS[("Per-tenant MySQL DBs<br/>data segregated by tenancy")]
    OBJ[("Object Storage (S3)<br/>3D models · raw scan archives")]
    EMAIL["Email / SMS Service"]

    CLIN -->|HTTPS| ROUTES
