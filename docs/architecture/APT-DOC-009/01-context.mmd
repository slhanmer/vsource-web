flowchart TB
    subgraph EXT_DEVICE["Medical Device Domain (Class A device — black box to Aptium)"]
        DEV["MultiScan4D Scanner<br/><i>Class A medical device</i><br/>captures &amp; uploads 3D scans"]
        PIPE["Scan Processing Pipeline<br/><i>opaque upstream of the Aptium back-end</i>"]
    end

    subgraph AptiumSystem["Aptium Portal System (Software Item — Class A, built to Class C process)"]
        BE["Back-end Service / API<br/>TypeScript · Express"]
        FE["Web Portal (front-end)<br/>Next.js 16 · React 19 · TypeScript"]
        RFS["Rust File Service<br/>object storage access via AWS SDK (S3)"]
        DB[("Per-tenant MySQL<br/>databases (segregated)")]
    end

    CLIN["Tenant User / Clinician<br/>(podiatry)"]
    ADMIN["Tenant Administrator"]
    SUPP["Support / Quality Reviewer"]
    PADMIN["Platform Administrator"]

    EMAIL["Email / SMS Service<br/><i>2FA, resets, notifications</i>"]
    MAPS["Google Places API<br/><i>address lookup</i>"]
    CREDITS["Credits / Token System<br/><i>no direct payments taken</i>"]

    DEV -->|3D scan + metadata<br/>scan_id, user_id, device_id| PIPE
    PIPE -->|ingested scan payload| BE
    BE <-->|reads / writes<br/>tenant records + metadata| DB
    BE <-->|store / retrieve<br/>3D model &amp; raw files| RFS
    BE -->|REST + WebSocket<br/>HTTP-only cookie session| FE
    FE -->|HTTPS| CLIN
    FE -->|HTTPS| ADMIN
    FE -->|HTTPS| SUPP
    FE -->|HTTPS| PADMIN
    BE <-->|verification codes| EMAIL
    FE <-->|proxied lookup| MAPS
    BE <-->|balance / consumption| CREDITS

    classDef device fill:#FFF3E0,stroke:#EF6C00,color:#1a1a1a;
    classDef ext fill:#ECEFF1,stroke:#546E7A,color:#1a1a1a;
    classDef store fill:#E8F5E9,stroke:#2E7D32,color:#1a1a1a;
    classDef actor fill:#E3F2FD,stroke:#1565C0,color:#1a1a1a;
    class DEV,PIPE device;
    class EMAIL,MAPS,CREDITS ext;
    class DB,RFS store;
    class CLIN,ADMIN,SUPP,PADMIN actor;
